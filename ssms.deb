},"MediaContents":[{"ImageContent":{"Description":"Today\u0027s image takes us to Monfragüe National Park, a natural treasure in the heart of Extremadura, Spain. From the viewpoint of Salto del Gitano, in Cáceres, you can enjoy one of the most stunning sunsets in the country, surrounded by rocky cliffs and skies painted in gold. Two rivers cross the park—the Tagus and the Tiétar—shaping its rugged landscape and nourishing a rich variety of wildlife and Mediterranean vegetation. This paradise is perfect for nature and bird lovers. Soaring freely over the park are griffon vultures—Spain is home to the largest colony in Europe—along with Spanish imperial eagles and Egyptian vultures, making it a true biodiversity hotspot.","Image":{"Url":"/th?id=OHR.ExtremaduraJamon_ROW7444306308_1920x1080.webp","Wallpaper":"/th?id=OHR.ExtremaduraJamon_ROW7444306308_1920x1200.jpg\u0026rf=LaDigue_1920x1200.jpg","Downloadable":true},"Headline":"Info","Title":"Peña Falcon rock on the Tagus river, Monfragüe National Park, Spain","Copyright":"© Daniel Viñé Garcia/Getty Images","SocialGood":null,"MapLink":{"Url":"","Link":""},"QuickFact":{"MainText":"","LinkUrl":"","LinkText":""},"TriviaUrl":"/search?q=Bing+homepage+quiz\u0026filters=WQOskey:\u0022HPQuiz_20250911_ExtremaduraJamon\u0022\u0026FORM=HPQUIZ","BackstageUrl":"/search?q=Monfrague+National+Park\u0026form=hpcapt\u0026filters=HpDate:\u002220250911_0700\u0022","TriviaId":"HPQuiz_20250911_ExtremaduraJamon"},"Ssd":"20250911","Name":"ExtremaduraJamon","Market":"ROW","Hash":"7444306308","FullDateString":"11. sep. 2025"}],"PreloadMediaContents":[],"LocStrings":{"LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD":"Dagens bilde","LOC_HOMEPAGE_VERTICAL_SCROLL_IOTD_LEARN_MORE":"Finn ut mer","LOC_HOMEPAGE_VERTICAL_SCROLL_DONATE_NOW":"Doner nå","LOC_HOMEPAGE_VERTICAL_SCROLL_FACT":"Hurtigfakta:","LOC_HOMEPAGE_GALLERY_CARD_TITLE":"Nylige hjemmesidebilder","LOC_HOMEPAGE_VERTICAL_SCROLL_GALLERY_IMAGE_ARIALABEL":"Hjemmesidebilde for {0}","LOC_HOMEPAGE_ON_THIS_DAY_TITL